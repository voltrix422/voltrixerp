# Copy to .env or .env.production on the VPS (do not commit real secrets).
# Primary domain used for server-side API fetches (blog, careers, etc.)
NEXT_PUBLIC_BASE_URL=https://voltrixpv.com

# Database, Supabase, etc. — keep your existing production values here.

# Email notifications — see .env.smtp.example for full Hostinger + Gmail guide
SMTP_PROVIDER=hostinger
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=erp@voltrix.com
SMTP_PASS=your-hostinger-mailbox-password
SMTP_FROM=erp@voltrix.com

# FBR Digital Invoicing (Branch POS only). Token from IRIS → Digital Invoicing → PRAL.
# Whitelist VPS IP 187.127.111.203. Leave FBR_TOKEN empty until sandbox token is issued.
FBR_ENV=sandbox
FBR_TOKEN=
FBR_SELLER_NTN=
FBR_SELLER_NAME=VOLTRIX BATTERIES (PRIVATE) LIMITED
FBR_SELLER_PROVINCE=Islamabad Capital Territory
FBR_SELLER_ADDRESS=Plot 73, Street 14, I-9/2, Islamabad
FBR_DEFAULT_HS_CODE=8507.6000
# Optional sandbox override (default SN001 registered / SN002 unregistered)
# FBR_SANDBOX_SCENARIO_ID=SN001
