# Copy to .env or .env.production on the VPS (do not commit real secrets).
# Primary domain used for server-side API fetches (blog, careers, etc.)
NEXT_PUBLIC_BASE_URL=https://voltrixpv.com

# Database, Supabase, etc. — keep your existing production values here.

# Email notifications — see .env.smtp.example for full Hostinger + Gmail guide
SMTP_PROVIDER=hostinger
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=erp@voltrix.com
SMTP_PASS=your-hostinger-mailbox-password
SMTP_FROM=erp@voltrix.com
