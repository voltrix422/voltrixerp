{
  "name": "rfid-usb-wedge-app",
  "version": "1.4.5",
  "private": true,
  "description": "Voltrix RFID Link — SDK-style inventory + product linking (USB keyboard wedge)",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.voltrix.rfidusbwedge",
    "productName": "Voltrix RFID Link",
    "files": ["src/**/*", "package.json"],
    "win": {
      "target": "nsis"
    }
  }
}
