  invoiceIds  Json     @default("[]") @map("invoice_ids")
  moveId      String   @default("") @map("move_id")
  createdBy   String   @default("") @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([paymentType, state])
  @@map("acct_payments")
}

model AcctBankAccount {
  id            String  @id @default(cuid())
  name          String
  accountNumber String  @default("") @map("account_number")
  bankName      String  @default("") @map("bank_name")
  journalId     String  @map("journal_id")
  balance       Float   @default(0)
  active        Boolean @default(true)

  @@map("acct_bank_accounts")
}

model AcctBankStatement {
  id             String   @id @default(cuid())
  name           String
  bankAccountId  String   @map("bank_account_id")
  date           DateTime
  balanceStart   Float    @map("balance_start")
  balanceEnd     Float    @map("balance_end")
  state          String   @default("open")
  createdAt      DateTime @default(now()) @map("created_at")

  lines AcctBankStatementLine[]

  @@map("acct_bank_statements")
}

model AcctBankStatementLine {
  id            String  @id @default(cuid())
  statementId   String  @map("statement_id")
  date          DateTime
  paymentRef    String  @default("") @map("payment_ref")
  partnerName   String  @default("") @map("partner_name")
  amount        Float
  reconciled    Boolean @default(false)
  moveLineId    String  @default("") @map("move_line_id")

  statement AcctBankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId])
  @@map("acct_bank_statement_lines")
}

model AcctAsset {
  id              String   @id @default(cuid())
  name            String
  originalValue   Float    @map("original_value")
  salvageValue    Float    @default(0) @map("salvage_value")
  method          String   @default("linear")
  durationMonths  Int      @default(36) @map("duration_months")
  acquisitionDate DateTime @map("acquisition_date")
  state           String   @default("draft")
  depreciationAccountCode String @default("5610") @map("depreciation_account_code")
  assetAccountCode      String @default("1510") @map("asset_account_code")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("acct_assets")
}

model AcctBudget {
  id         String @id @default(cuid())
  name       String
  fiscalYear Int    @map("fiscal_year")
  lines      Json   @default("[]")
  state      String @default("draft")

  @@map("acct_budgets")
}

model AcctDeferredEntry {
  id          String   @id @default(cuid())
  name        String
  entryType   String   @map("entry_type")
  totalAmount Float    @map("total_amount")
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  periods     Int      @default(12)
  state       String   @default("draft")
  accountCode String   @map("account_code")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("acct_deferred_entries")
}

model AcctSequence {
  id      String @id
  prefix  String
  nextNum Int    @map("next_num")

  @@map("acct_sequences")
}
