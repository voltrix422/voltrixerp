generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ErpUser {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  password           String
  role               String   @default("user")
  modules            Json     @default("[]")
  managerId          String?  @map("manager_id")
  location           String   @default("")
  jobTitle           String   @default("field_sales_officer") @map("job_title")
  baseSalary         Float    @default(25000) @map("base_salary")
  commissionPercent  Float    @default(0.5) @map("commission_percent")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([role])
  @@index([managerId])
  @@map("erp_users")
}

model ErpSalesAgentCompensationHistory {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  baseSalary        Float    @map("base_salary")
  commissionPercent Float    @map("commission_percent")
  effectiveFrom     DateTime @default(now()) @map("effective_from")
  note              String   @default("")
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([userId, effectiveFrom])
  @@map("erp_sales_agent_compensation_history")
}

model ErpSupplier {
  id               String  @id @default(cuid())
  name             String
  type             String
  contact          String  @default("")
  email            String  @default("")
  address          String  @default("")
  company          String  @default("")
  bankAccountName  String? @map("bank_account_name")
  bankIban         String? @map("bank_iban")
  image            String? @default("")

  @@map("erp_suppliers")
}

model ErpPurchaseOrder {
  id                   String   @id @default(cuid())
  poNumber             String?  @map("po_number")
  type                 String
  supplierIds          Json     @default("[]") @map("supplier_ids")
  supplierNames        Json     @default("[]") @map("supplier_names")
  items                Json     @default("[]")
  notes                String   @default("")
  status               String
  createdBy            String?  @map("created_by")
  createdAt            DateTime @default(now()) @map("created_at")
  adminNote            String   @default("") @map("admin_note")
  sentToSupplier       Boolean  @default(false) @map("sent_to_supplier")
  deliveryDate         String   @default("") @map("delivery_date")
  receivingLocation    String   @default("") @map("receiving_location")
  suppliersSent        Json     @default("[]") @map("suppliers_sent")
  quotes               Json     @default("[]")
  finalizedSupplierId  String?  @map("finalized_supplier_id")
  payments             Json     @default("[]")
  paymentAmount        Float?   @map("payment_amount")
  paymentMethod        String?  @map("payment_method")
  paymentDate          String?  @map("payment_date")
  paymentProof         String?  @map("payment_proof")
  paymentNotes         String?  @map("payment_notes")
  adminDocuments       Json     @default("[]") @map("admin_documents")
  financeDocuments1    Json     @default("[]") @map("finance_documents_1")
  purchaseDocuments    Json     @default("[]") @map("purchase_documents")
  financeDocuments2    Json     @default("[]") @map("finance_documents_2")
  pssid                String?
  importedSupplierName String?  @map("imported_supplier_name")
  importedItems        Json     @default("[]") @map("imported_items")
  flowHistory          Json     @default("[]") @map("flow_history")

  @@map("erp_purchase_orders")
}

model ErpOrder {
  id               String   @id @default(cuid())
  orderNumber      String   @map("order_number")
  clientId         String   @map("client_id")
  clientName       String   @map("client_name")
  items            Json     @default("[]")
  subtotal         Float    @default(0)
  taxPercent       Float    @default(0) @map("tax_percent")
  tax              Float    @default(0)
  transportCost    Float    @default(0) @map("transport_cost")
  transportLabel   String   @default("Transport") @map("transport_label")
  otherCost        Float    @default(0) @map("other_cost")
  otherCostLabel   String   @default("Other") @map("other_cost_label")
  shipping         Float    @default(0)
  discount         Float    @default(0)
  total            Float    @default(0)
  status           String
  notes            String   @default("")
  createdAt        DateTime @default(now()) @map("created_at")
  createdBy        String   @map("created_by")
  deliveryAddress  String   @default("") @map("delivery_address")
  deliveryDate     String   @default("") @map("delivery_date")
  dispatcher       String?
  pdfUrl           String?  @map("pdf_url")
  payments         Json     @default("[]")
  ownerUserId                    String?  @map("owner_user_id")
  salesAgentCommissionPercent    Float?   @map("sales_agent_commission_percent")
  salesAgentCommissionAmount     Float?   @map("sales_agent_commission_amount")
  fulfillmentDispatcher          String? @map("fulfillment_dispatcher")
  fulfillmentReceiverName        String? @map("fulfillment_receiver_name")
  fulfillmentReceiverCnic        String? @map("fulfillment_receiver_cnic")
  fulfillmentVehicleNumber       String? @map("fulfillment_vehicle_number")
  fulfillmentDate                String? @map("fulfillment_date")
  fulfillmentReceiverImageUrl      String? @map("fulfillment_receiver_image_url")
  fulfillmentReceiverCnicImageUrl  String? @map("fulfillment_receiver_cnic_image_url")
  fulfillmentVehicleImageUrl       String? @map("fulfillment_vehicle_image_url")
  fulfillmentProductImageUrls      Json    @default("[]") @map("fulfillment_product_image_urls")

  @@map("erp_orders")
}

model ErpClient {
  id            String   @id @default(cuid())
  name          String
  company       String   @default("")
  email         String   @default("")
  phone         String   @default("")
  address       String   @default("")
  city          String   @default("")
  country       String   @default("")
  website       String   @default("")
  taxId         String   @default("") @map("tax_id")
  industry      String   @default("")
  contactPerson String   @default("") @map("contact_person")
  imageUrl      String?  @map("image_url")
  notes         String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String   @map("created_by")
  ownerUserId   String?  @map("owner_user_id")
  status        String   @default("active")

  @@map("erp_clients")
}

model ErpDoc {
  id          String   @id @default(cuid())
  name        String
  category    String
  fileUrl     String   @map("file_url")
  fileType    String?  @map("file_type")
  fileSize    Int?     @map("file_size")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by")

  @@map("erp_docs")
}

model ErpInventoryStock {
  id              String   @id @default(cuid())
  poId            String?  @map("po_id")
  poNumber        String   @map("po_number")
  itemId          String   @map("item_id")
  name            String   @default("")
  description     String
  unit            String   @default("")
  specs           String   @default("")
  receivedQty     Float    @default(0) @map("received_qty")
  availableQty    Float    @default(0) @map("available_qty")
  allocatedQty    Float    @default(0) @map("allocated_qty")
  costPrice       Float    @default(0) @map("cost_price")
  supplierName    String   @default("") @map("supplier_name")
  poType          String   @default("local") @map("po_type")
  gst             Float    @default(0)
  gstIsPercentage Boolean  @default(false) @map("gst_is_percentage")
  gstInput        Float    @default(0) @map("gst_input")
  otherExpense    Float    @default(0) @map("other_expense")
  otherExpenses   String   @default("") @map("other_expenses")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("erp_inventory_stock")
}

model ErpInventoryHistory {
  id              String   @id @default(cuid())
  itemDescription String   @map("item_description")
  transactionType String   @map("transaction_type")
  quantity        Float
  unit            String
  referenceType   String   @map("reference_type")
  referenceId     String   @map("reference_id")
  referenceNumber String   @map("reference_number")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  createdBy       String   @map("created_by")

  @@map("erp_inventory_history")
}

model ErpOrderFulfillmentHistory {
  id                        String   @id @default(cuid())
  orderId                   String   @map("order_id")
  orderNumber               String   @map("order_number")
  clientName                String   @map("client_name")
  dispatcherName            String   @map("dispatcher_name")
  receiverName              String   @map("receiver_name")
  receiverCnic              String   @map("receiver_cnic")
  vehicleNumber             String   @map("vehicle_number")
  receiverImageUrl          String?  @map("receiver_image_url")
  receiverCnicImageUrl      String?  @map("receiver_cnic_image_url")
  vehicleImageUrl           String?  @map("vehicle_image_url")
  productImageUrls          Json     @default("[]") @map("product_image_urls")
  fulfilledAt               DateTime @default(now()) @map("fulfilled_at")
  fulfilledBy               String   @map("fulfilled_by")
  notes                     String?  @default("")
  createdAt                 DateTime @default(now()) @map("created_at")

  @@map("erp_order_fulfillment_history")
}

model ErpQuotation {
  id              String   @id @default(cuid())
  productType     String?  @map("product_type")
  voltage         String?
  capacity        String?
  quantity        Int?
  budget          String?
  application     String?
  specifications  String?
  timeline        String?
  fullName        String   @map("full_name")
  company         String   @default("")
  email           String
  phone           String   @default("")
  status          String   @default("new")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("quotations")
}

model ErpStaff {
  id            String   @id @default(cuid())
  name          String
  role          String
  department    String
  email         String
  phone         String
  address       String
  salary        Float
  currency      String
  joinDate      String   @map("join_date")
  status        String
  notes         String
  points        Int      @default(100) @map("points")
  warnings      Json     @default("[]") @map("warnings")
  lastReset     DateTime @default(now()) @map("last_reset")
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  bankName          String?  @default("") @map("bank_name")
  bankAccountNumber String?  @default("") @map("bank_account_number")
  bankAccountTitle  String?  @default("") @map("bank_account_title")

  @@map("erp_staff")
}

model ErpFinanceRecord {
  id                  String   @id @default(cuid())
  title               String
  amount              Float
  currency            String
  purpose             String
  category            String
  tag                 String
  supplier_name              String   @default("") @map("supplier_name")
  receipt_person_name        String   @default("") @map("receipt_person_name")
  petty_cash_allocation_id   String   @default("") @map("petty_cash_allocation_id")
  petty_cash_receipt_id      String   @default("") @map("petty_cash_receipt_id")
  petty_cash_label           String   @default("") @map("petty_cash_label")
  proof_url           String   @map("proof_url")
  proof_name          String   @map("proof_name")
  notes               String
  created_by          String   @map("created_by")
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("erp_finance_records")
}

model ErpBranch {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  type        String   @default("outlet")
  address     String   @default("")
  city        String   @default("")
  country     String   @default("")
  phone       String   @default("")
  email       String   @default("")
  manager     String   @default("")
  status      String   @default("active")
  notes       String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by")

  @@map("erp_branches")
}

model ErpBranchInventory {
  id                String   @id @default(cuid())
  branchId          String   @map("branch_id")
  inventoryId       String   @map("inventory_id")
  productDescription String   @default("") @map("product_description")
  quantity          Float    @default(0)
  unit              String   @default("")
  assignedAt        DateTime @default(now()) @map("assigned_at")
  assignedBy        String   @map("assigned_by")
  notes             String   @default("")

  @@map("erp_branch_inventory")
}

model ErpBranchInventoryTransfer {
  id                 String   @id @default(cuid())
  fromBranchId       String?  @map("from_branch_id")
  fromBranchName     String   @map("from_branch_name")
  fromBranchCode     String   @default("") @map("from_branch_code")
  toBranchId         String   @map("to_branch_id")
  toBranchName       String   @map("to_branch_name")
  toBranchCode       String   @default("") @map("to_branch_code")
  inventoryId        String   @map("inventory_id")
  productDescription String   @map("product_description")
  quantity           Float
  unit               String
  note               String   @default("")
  transferredBy      String   @map("transferred_by")
  transferredAt      DateTime @default(now()) @map("transferred_at")

  @@index([fromBranchId])
  @@index([toBranchId])
  @@map("erp_branch_inventory_transfers")
}

model ErpTicket {
  id          String   @id @default(cuid())
  ticketNumber String  @unique @map("ticket_number")
  customerName String  @map("customer_name")
  customerEmail String @map("customer_email")
  customerPhone String? @map("customer_phone")
  subject     String
  description String
  status      String   @default("open")
  priority    String   @default("medium")
  assignedTo  String?  @map("assigned_to")
  resolution  String?  @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  closedAt    DateTime? @map("closed_at")
  createdBy   String?  @map("created_by")

  @@map("erp_tickets")
}

model ErpWarranty {
  id                String   @id @default(cuid())
  warrantyId        String?  @unique @map("warranty_id")
  serialNumber      String?  @unique @map("serial_number")
  productName       String   @map("product_name")
  soldDate          DateTime @map("sold_date")
  warrantyStartDate DateTime @map("warranty_start_date")
  warrantyEndDate   DateTime @map("warranty_end_date")
  customerName      String?  @map("customer_name")
  customerEmail     String?  @map("customer_email")
  customerPhone     String?  @map("customer_phone")
  notes             String?  @default("")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdBy          String?  @map("created_by")

  @@map("erp_warranties")
}

model ErpInventorySerialUnit {
  id               String   @id @default(cuid())
  serialNumber     String   @unique @map("serial_number")
  assignedName     String   @default("") @map("assigned_name")
  productName      String   @default("") @map("product_name")
  model            String   @default("")
  specs            String   @default("")
  rawPayload       String   @default("") @map("raw_payload")
  inventoryStockId String?  @map("inventory_stock_id")
  warrantyId       String?  @map("warranty_id")
  warrantyStartDate DateTime? @map("warranty_start_date")
  warrantyEndDate   DateTime? @map("warranty_end_date")
  status           String   @default("in_stock")
  notes            String   @default("")
  scannedBy        String   @default("system") @map("scanned_by")
  scannedAt        DateTime @default(now()) @map("scanned_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([inventoryStockId])
  @@map("erp_inventory_serial_units")
}

model ErpInventoryModelLabel {
  id          String   @id @default(cuid())
  model       String   @unique
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("erp_inventory_model_labels")
}

model ErpWarrantyClaim {
  id           String   @id @default(cuid())
  unitId       String   @map("unit_id")
  serialNumber String   @map("serial_number")
  claimReason  String   @map("claim_reason")
  status       String   @default("pending")
  notes        String   @default("")
  claimedBy    String   @default("system") @map("claimed_by")
  reviewedBy   String?  @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([unitId])
  @@index([serialNumber])
  @@map("erp_warranty_claims")
}

model ErpBlog {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  coverImage  String?  @map("cover_image")
  published   Boolean  @default(false)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by")

  @@map("erp_blogs")
}

model ErpJob {
  id          String   @id @default(cuid())
  title       String
  location    String
  type        String
  description String
  requirements String
  salary      String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by")

  @@map("erp_jobs")
}

model ErpDispatch {
  id               String   @id @default(cuid())
  orderId          String   @map("order_id")
  customerName     String   @map("customer_name")
  customerPhone    String   @default("") @map("customer_phone")
  deliveryAddress  String   @map("delivery_address")
  items            Json     @default("[]")
  dispatchDate     String   @default("") @map("dispatch_date")
  expectedDelivery String   @default("") @map("expected_delivery")
  status           String   @default("pending")
  courierService   String   @default("own_driver") @map("courier_service")
  driverName       String   @default("") @map("driver_name")
  driverPhone      String   @default("") @map("driver_phone")
  vehicleNumber    String   @default("") @map("vehicle_number")
  trackingId       String   @default("") @map("tracking_id")
  notes            String   @default("")
  createdBy        String?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("erp_dispatches")
}

model ErpRfidTag {
  id              String   @id @default(cuid())
  epc             String   @unique
  itemId          String?  @map("item_id")
  sku             String?  @default("")
  itemDescription String   @default("") @map("item_description")
  status          String   @default("IN_STOCK")
  warehouse       String   @default("")
  dispatchId      String?  @map("dispatch_id")
  orderId         String?  @map("order_id")
  invoiceNumber   String?  @map("invoice_number")
  authorizedAt    DateTime? @map("authorized_at")
  authorizedUntil DateTime? @map("authorized_until")
  exitedAt        DateTime? @map("exited_at")
  updatedBy       String?  @map("updated_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("erp_rfid_tags")
}

model ErpRfidGateEvent {
  id             String   @id @default(cuid())
  epc            String
  gateName       String   @default("MAIN_GATE") @map("gate_name")
  decision       String
  triggerAlarm   Boolean  @default(false) @map("trigger_alarm")
  reason         String   @default("")
  dispatchId     String?  @map("dispatch_id")
  orderId        String?  @map("order_id")
  invoiceNumber  String?  @map("invoice_number")
  scannedBy      String   @default("system") @map("scanned_by")
  scannedAt      DateTime @default(now()) @map("scanned_at")

  @@map("erp_rfid_gate_events")
}

model ErpSalarySlip {
  id               String   @id @default(cuid())
  staffName        String   @map("staff_name")
  staffRole        String   @map("staff_role")
  staffDepartment  String   @map("staff_department")
  month            String
  baseSalary       Float    @map("base_salary")
  currency         String   @default("USD")
  adjustments      Json     @default("[]")
  netSalary        Float    @map("net_salary")
  generatedDate    DateTime @map("generated_date")
  bankName         String   @default("") @map("bank_name")
  bankAccountNumber String  @default("") @map("bank_account_number")
  bankAccountTitle String   @default("") @map("bank_account_title")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("erp_salary_slips")
}

model CrmQuotation {
  id                      String   @id @default(cuid())
  quotationNumber         String   @map("quotation_number")
  clientId                String   @map("client_id")
  clientName              String   @map("client_name")
  items                   Json     @default("[]")
  subtotal                Float    @default(0)
  taxPercent              Float    @default(0) @map("tax_percent")
  tax                     Float    @default(0)
  transportCost           Float    @default(0) @map("transport_cost")
  transportLabel          String   @default("Transport") @map("transport_label")
  transportIsPercentage   Boolean  @default(false) @map("transport_is_percentage")
  transportCostValue      Float    @default(0) @map("transport_cost_value")
  otherCost               Float    @default(0) @map("other_cost")
  otherCostLabel          String   @default("Other") @map("other_cost_label")
  otherCostIsPercentage   Boolean  @default(false) @map("other_cost_is_percentage")
  otherCostValue          Float    @default(0) @map("other_cost_value")
  discount                Float    @default(0)
  discountIsPercentage    Boolean  @default(true) @map("discount_is_percentage")
  discountValue           Float    @default(0) @map("discount_value")
  total                   Float    @default(0)
  status                  String   @default("draft")
  notes                   String   @default("")
  deliveryAddress         String   @default("") @map("delivery_address")
  validUntil              String   @default("") @map("valid_until")
  createdAt               DateTime @default(now()) @map("created_at")
  createdBy               String   @map("created_by")
  ownerUserId             String?  @map("owner_user_id")
  convertedToOrderId      String?  @map("converted_to_order_id")

  @@map("crm_quotations")
}

/// Sales leads (CSV import + manual). Separate from ErpClient (order/customer records).
model CrmLead {
  id            String   @id @default(cuid())
  name          String
  company       String   @default("")
  email         String   @default("")
  phone         String   @default("")
  notes         String   @default("")
  source        String   @default("csv") // csv | manual
  status        String   @default("new") // new | contacted | responded | closed
  importedAt    DateTime @default(now()) @map("imported_at")
  createdBy     String   @map("created_by")
  createdById   String?  @map("created_by_id")
  importBatchId      String?  @map("import_batch_id")
  importUploaderName String?  @map("import_uploader_name")
  contacts      CrmLeadContact[]

  @@index([importBatchId])
  @@map("crm_leads")
}

/// One outreach log per contact attempt (screenshots + lead response).
model CrmLeadContact {
  id             String   @id @default(cuid())
  leadId         String   @map("lead_id")
  lead           CrmLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactedAt    DateTime @default(now()) @map("contacted_at")
  contactedBy    String   @map("contacted_by")
  contactedById  String?  @map("contacted_by_id")
  screenshotUrls Json     @default("[]") @map("screenshot_urls")
  leadResponse   String   @default("") @map("lead_response")
  notes          String   @default("")

  @@index([leadId])
  @@index([contactedAt])
  @@index([contactedBy, contactedAt])
  @@map("crm_lead_contacts")
}

model ErpPettyCashAllocation {
  id            String   @id @default(cuid())
  employeeId    String   @map("employee_id")
  employeeName  String   @map("employee_name")
  employeeRole  String   @map("employee_role")
  amount        Float
  purpose       String
  payoutMethod  String?  @map("payout_method")
  paymentProof  String?  @map("payment_proof")
  paymentProofName String? @map("payment_proof_name")
  notes         String   @default("")
  status        String   @default("active") // pending, active, settled, cancelled, rejected
  allocatedBy   String   @map("allocated_by")
  allocatedAt   DateTime @default(now()) @map("allocated_at")
  settledAt     DateTime? @map("settled_at")
  reviewedBy    String?  @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  reviewNotes   String?  @map("review_notes")

  @@map("erp_petty_cash_allocations")
}

model ErpPettyCashReceipt {
  id                String   @id @default(cuid())
  allocationId      String   @map("allocation_id")
  employeeName      String   @map("employee_name")
  description       String
  amount            Float
  receiptProof      String?  @map("receipt_proof")
  receiptProofName  String?  @map("receipt_proof_name")
  notes             String   @default("")
  status            String   @default("pending") // pending, approved, rejected
  submittedAt       DateTime @default(now()) @map("submitted_at")
  reviewedBy        String?  @map("reviewed_by")
  reviewedAt        DateTime? @map("reviewed_at")
  reviewNotes       String?  @map("review_notes")

  @@map("erp_petty_cash_receipts")
}
