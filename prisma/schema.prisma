generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ErpUser {
  id                        String   @id @default(cuid())
  name                      String
  email                     String   @unique
  password                  String
  role                      String   @default("user")
  modules                   Json     @default("[]")
  managerId                 String?  @map("manager_id")
  location                  String   @default("")
  jobTitle                  String   @default("field_sales_officer") @map("job_title")
  baseSalary                Float    @default(25000) @map("base_salary")
  commissionPercent         Float    @default(0.5) @map("commission_percent")
  notificationEmails        Json     @default("[]") @map("notification_emails")
  emailNotificationsEnabled Boolean  @default(true) @map("email_notifications_enabled")
  branchId                  String?  @map("branch_id")
  purchaseScopes            Json     @default("[]") @map("purchase_scopes")
  createdAt                 DateTime @default(now()) @map("created_at")

  @@index([role])
  @@index([managerId])
  @@index([branchId])
  @@map("erp_users")
}

model ErpNotification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  message   String   @default("")
  type      String   @default("info")
  link      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("erp_notifications")
}

model ErpSalesAgentCompensationHistory {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  baseSalary        Float    @map("base_salary")
  commissionPercent Float    @map("commission_percent")
  effectiveFrom     DateTime @default(now()) @map("effective_from")
  note              String   @default("")
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([userId, effectiveFrom])
  @@map("erp_sales_agent_compensation_history")
}

model ErpPurchaseScope {
  id        String   @id
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("erp_purchase_scopes")
}

model ErpSupplier {
  id               String  @id @default(cuid())
  purchaseScopeId  String  @default("P1") @map("purchase_scope_id")
  name             String
  type             String
  contact          String  @default("")
  email            String  @default("")
  address          String  @default("")
  company          String  @default("")
  tradingAs        String  @default("") @map("trading_as")
  bankAccountName  String? @map("bank_account_name")
  bankIban         String? @map("bank_iban")
  accountTitle     String  @default("") @map("account_title")
  bankNames        Json    @default("[]") @map("bank_names")
  image            String? @default("")

  @@index([purchaseScopeId])
  @@map("erp_suppliers")
}

model ErpPurchaseOrder {
  id                   String   @id @default(cuid())
  poNumber             String?  @map("po_number")
  type                 String
  supplierIds          Json     @default("[]") @map("supplier_ids")
  supplierNames        Json     @default("[]") @map("supplier_names")
  items                Json     @default("[]")
  notes                String   @default("")
  status               String
  createdBy            String?  @map("created_by")
  createdAt            DateTime @default(now()) @map("created_at")
  adminNote            String   @default("") @map("admin_note")
  sentToSupplier       Boolean  @default(false) @map("sent_to_supplier")
  deliveryDate         String   @default("") @map("delivery_date")
  receivingLocation    String   @default("") @map("receiving_location")
  suppliersSent        Json     @default("[]") @map("suppliers_sent")
  quotes               Json     @default("[]")
  finalizedSupplierId  String?  @map("finalized_supplier_id")
  payments             Json     @default("[]")
  paymentAmount        Float?   @map("payment_amount")
  paymentMethod        String?  @map("payment_method")
  paymentDate          String?  @map("payment_date")
  paymentProof         String?  @map("payment_proof")
  paymentNotes         String?  @map("payment_notes")
  adminDocuments       Json     @default("[]") @map("admin_documents")
  financeDocuments1    Json     @default("[]") @map("finance_documents_1")
  purchaseDocuments    Json     @default("[]") @map("purchase_documents")
  financeDocuments2    Json     @default("[]") @map("finance_documents_2")
  pssid                String?
  importedSupplierName String?  @map("imported_supplier_name")
  importedItems        Json     @default("[]") @map("imported_items")
  flowHistory          Json     @default("[]") @map("flow_history")

  @@map("erp_purchase_orders")
}

model ErpPurchaseLedger {
  id                String   @id @default(cuid())
  purchaseScopeId   String   @default("P1") @map("purchase_scope_id")
  ledgerNumber      String   @map("ledger_number")
  transactionDate   String   @map("transaction_date")
  linkMode          String   @default("general") @map("link_mode")
  projectName       String   @default("") @map("project_name")
  orderId           String?  @map("order_id")
  orderNumber       String   @default("") @map("order_number")
  supplierId        String?  @map("supplier_id")
  supplierName      String   @default("") @map("supplier_name")
  productName       String   @default("") @map("product_name")
  transactionType   String   @default("purchase") @map("transaction_type")
  category          String   @default("expense")
  quantity          Float    @default(0)
  unitPrice         Float    @default(0) @map("unit_price")
  totalAmount       Float    @default(0) @map("total_amount")
  amountPaid        Float    @default(0) @map("amount_paid")
  amountDue         Float    @default(0) @map("amount_due")
  items             Json     @default("[]")
  supplierGroups    Json     @default("[]") @map("supplier_groups")
  payments          Json     @default("[]")
  notes             String   @default("")
  dueDate           String   @default("") @map("due_date")
  accountDetails    String   @default("") @map("account_details")
  paymentProofUrl   String   @default("") @map("payment_proof_url")
  paymentProofName  String   @default("") @map("payment_proof_name")
  createdBy         String   @default("") @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([purchaseScopeId, ledgerNumber])
  @@index([transactionDate])
  @@index([supplierId])
  @@index([orderId])
  @@index([category])
  @@map("erp_purchase_ledger")
}

model ErpAdvanceAccount {
  id              String   @id @default(cuid())
  purchaseScopeId String   @default("P1") @map("purchase_scope_id")
  personName      String   @map("person_name")
  purpose         String   @default("")
  notes           String   @default("")
  status          String   @default("open")
  transactions    Json     @default("[]")
  totalDeposited  Float    @default(0) @map("total_deposited")
  totalSpent      Float    @default(0) @map("total_spent")
  balance         Float    @default(0)
  createdBy       String   @default("") @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([purchaseScopeId])
  @@index([status])
  @@map("erp_advance_accounts")
}

/** Client installation / solar projects: budget, client payments, expenses, profit */
model ErpClientProject {
  id              String   @id @default(cuid())
  purchaseScopeId String   @default("P1") @map("purchase_scope_id")
  projectName     String   @map("project_name")
  clientName      String   @default("") @map("client_name")
  clientPhone     String   @default("") @map("client_phone")
  budget          Float    @default(0)
  notes           String   @default("")
  status          String   @default("open")
  transactions    Json     @default("[]")
  totalReceived   Float    @default(0) @map("total_received")
  totalExpenses   Float    @default(0) @map("total_expenses")
  profit          Float    @default(0)
  createdBy       String   @default("") @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([purchaseScopeId])
  @@index([status])
  @@map("erp_client_projects")
}

model ErpOrder {
  id               String   @id @default(cuid())
  orderNumber      String   @map("order_number")
  clientId         String   @map("client_id")
  clientName       String   @map("client_name")
  items            Json     @default("[]")
  subtotal         Float    @default(0)
  taxPercent       Float    @default(0) @map("tax_percent")
  tax              Float    @default(0)
  transportCost    Float    @default(0) @map("transport_cost")
  transportLabel   String   @default("Transport") @map("transport_label")
  otherCost        Float    @default(0) @map("other_cost")
  otherCostLabel   String   @default("Other") @map("other_cost_label")
  shipping         Float    @default(0)
  discount         Float    @default(0)
  total            Float    @default(0)
  status           String
  notes            String   @default("")
  createdAt        DateTime @default(now()) @map("created_at")
  createdBy        String   @map("created_by")
  deliveryAddress  String   @default("") @map("delivery_address")
  deliveryDate     String   @default("") @map("delivery_date")
  dispatcher       String?
  pdfUrl           String?  @map("pdf_url")
  payments         Json     @default("[]")
  ownerUserId                    String?  @map("owner_user_id")
  salesAgentCommissionPercent    Float?   @map("sales_agent_commission_percent")
  salesAgentCommissionAmount     Float?   @map("sales_agent_commission_amount")
  fulfillmentDispatcher          String? @map("fulfillment_dispatcher")
  fulfillmentReceiverName        String? @map("fulfillment_receiver_name")
  fulfillmentReceiverCnic        String? @map("fulfillment_receiver_cnic")
  fulfillmentVehicleNumber       String? @map("fulfillment_vehicle_number")
  fulfillmentDate                String? @map("fulfillment_date")
  fulfillmentReceiverImageUrl      String? @map("fulfillment_receiver_image_url")
  fulfillmentReceiverCnicImageUrl  String? @map("fulfillment_receiver_cnic_image_url")
  fulfillmentVehicleImageUrl       String? @map("fulfillment_vehicle_image_url")
  fulfillmentProductImageUrls      Json    @default("[]") @map("fulfillment_product_image_urls")
  fulfillmentSerialAllocations   Json    @default("[]") @map("fulfillment_serial_allocations")
  inventoryDeductedAt              String? @map("inventory_deducted_at")
  paymentTerms                     String  @default("full") @map("payment_terms")
  creditApprovedAt               String? @map("credit_approved_at")
  creditApprovedBy               String? @map("credit_approved_by")
  creditNote                     String? @map("credit_note")
  /** Set when order is created from Branch POS — stock comes from branch inventory only. */
  branchId                       String? @map("branch_id")
  /** "branch_pos" | "crm" (null/crm = normal ERP order) */
  source                         String? @map("source")
  /** CRM order return — stock restored and refunds tracked separately from payments. */
  returnedAt                     String? @map("returned_at")
  returnedBy                     String? @map("returned_by")
  returnReason                   String  @default("") @map("return_reason")
  inventoryReturnedAt            String? @map("inventory_returned_at")
  returnPayments                 Json    @default("[]") @map("return_payments")

  @@index([branchId])
  @@index([source])
  @@index([status])
  @@map("erp_orders")
}

model ErpClient {
  id            String   @id @default(cuid())
  name          String
  company       String   @default("")
  email         String   @default("")
  phone         String   @default("")
  address       String   @default("")
  city          String   @default("")
  country       String   @default("")
  website       String   @default("")
  taxId         String   @default("") @map("tax_id")
  ntn           String   @default("")
  industry      String   @default("")
  contactPerson String   @default("") @map("contact_person")
  imageUrl      String?  @map("image_url")
  notes         String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String   @map("created_by")
  ownerUserId   String?  @map("owner_user_id")
  status        String   @default("active")

  @@map("erp_clients")
}

model ErpDoc {
  id          String   @id @default(cuid())
  name        String
  category    String
  fileUrl     String   @map("file_url")
  fileType    String?  @map("file_type")
  fileSize    Int?     @map("file_size")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by")

  @@map("erp_docs")
}

model ErpInventoryStock {
  id              String   @id @default(cuid())
  poId            String?  @map("po_id")
  poNumber        String   @map("po_number")
  itemId          String   @map("item_id")
  name            String   @default("")
  description     String
  unit            String   @default("")
  specs           String   @default("")
  receivedQty     Float    @default(0) @map("received_qty")
  availableQty    Float    @default(0) @map("available_qty")
  allocatedQty    Float    @default(0) @map("allocated_qty")
  costPrice       Float    @default(0) @map("cost_price")
  supplierName    String   @default("") @map("supplier_name")
  poType          String   @default("local") @map("po_type")
  gst             Float    @default(0)
  gstIsPercentage Boolean  @default(false) @map("gst_is_percentage")
  gstInput        Float    @default(0) @map("gst_input")
  otherExpense    Float    @default(0) @map("other_expense")
  otherExpenses   String   @default("") @map("other_expenses")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("erp_inventory_stock")
}

model ErpManualInventoryItem {
  id               String   @id @default(cuid())
  name             String
  model            String   @unique
  qty              Float
  availableQty     Float    @map("available_qty")
  unit             String   @default("pcs")
  notes            String   @default("")
  inventoryStockId String?  @map("inventory_stock_id")
  createdBy        String   @default("") @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("erp_manual_inventory_item")
}

model ErpInventoryHistory {
  id              String   @id @default(cuid())
  itemDescription String   @map("item_description")
  transactionType String   @map("transaction_type")
  quantity        Float
  unit            String
  referenceType   String   @map("reference_type")
  referenceId     String   @map("reference_id")
  referenceNumber String   @map("reference_number")
  notes           String?
  stockBefore     Float?   @map("stock_before")
  stockAfter      Float?   @map("stock_after")
  locationLabel   String?  @map("location_label")
  createdAt       DateTime @default(now()) @map("created_at")
  createdBy       String   @map("created_by")

  @@map("erp_inventory_history")
}

model ErpOrderFulfillmentHistory {
  id                        String   @id @default(cuid())
  orderId                   String   @map("order_id")
  orderNumber               String   @map("order_number")
  clientName                String   @map("client_name")
  dispatcherName            String   @map("dispatcher_name")
  receiverName              String   @map("receiver_name")
  receiverCnic              String   @map("receiver_cnic")
  vehicleNumber             String   @map("vehicle_number")
  receiverImageUrl          String?  @map("receiver_image_url")
  receiverCnicImageUrl      String?  @map("receiver_cnic_image_url")
  vehicleImageUrl           String?  @map("vehicle_image_url")
  productImageUrls          Json     @default("[]") @map("product_image_urls")
  fulfilledAt               DateTime @default(now()) @map("fulfilled_at")
  fulfilledBy               String   @map("fulfilled_by")
  notes                     String?  @default("")
  createdAt                 DateTime @default(now()) @map("created_at")

  @@map("erp_order_fulfillment_history")
}

model ErpQuotation {
  id              String   @id @default(cuid())
  productType     String?  @map("product_type")
  voltage         String?
  capacity        String?
  quantity        Int?
  budget          String?
  application     String?
  specifications  String?
  timeline        String?
  fullName        String   @map("full_name")
  company         String   @default("")
  email           String
  phone           String   @default("")
  status          String   @default("new")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("quotations")
}

model ErpStaff {
  id            String   @id @default(cuid())
  name          String
  role          String
  department    String
  email         String
  phone         String
  address       String
  salary        Float
  taxAmount     Float    @default(0) @map("tax_amount")
  taxEnabled    Boolean  @default(false) @map("tax_enabled")
  currency      String
  joinDate      String   @map("join_date")
  status        String
  notes         String
  points        Int      @default(100) @map("points")
  warnings      Json     @default("[]") @map("warnings")
  lastReset     DateTime @default(now()) @map("last_reset")
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  bankName          String?  @default("") @map("bank_name")
  bankAccountNumber String?  @default("") @map("bank_account_number")
  bankAccountTitle  String?  @default("") @map("bank_account_title")
  erpUserId         String?  @map("erp_user_id")

  staffKpis      HrmStaffKpi[]
  kpiSettlements HrmKpiSettlement[]
  dailyReports   HrmDailyReport[]
  salaryAdvances HrmSalaryAdvance[]

  @@index([email])
  @@index([erpUserId])
  @@map("erp_staff")
}

/// Admin-defined KPI template (e.g. weekly sales target).
model HrmKpiTemplate {
  id             String   @id @default(cuid())
  name           String
  description    String   @default("")
  unit           String   @default("count") // currency | count | percent
  defaultTarget  Float    @default(0) @map("default_target")
  defaultWeight  Float    @default(0) @map("default_weight")
  periodType     String   @default("weekly") @map("period_type") // weekly | monthly
  active         Boolean  @default(true)
  sortOrder      Int      @default(0) @map("sort_order")
  createdBy      String   @default("") @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  staffKpis HrmStaffKpi[]

  @@map("hrm_kpi_templates")
}

/// KPI assigned to a staff member (from template or custom).
model HrmStaffKpi {
  id           String   @id @default(cuid())
  staffId      String   @map("staff_id")
  staff        ErpStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  templateId   String?  @map("template_id")
  template     HrmKpiTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name         String
  unit         String   @default("count")
  targetValue  Float    @default(0) @map("target_value")
  weight       Float    @default(0)
  periodType   String   @default("weekly") @map("period_type")
  active       Boolean  @default(true)
  notes               String   @default("")
  assignedBy          String   @default("") @map("assigned_by")
  approvedActual      Float    @default(0) @map("approved_actual")
  lastApprovedPeriod  String   @default("") @map("last_approved_period")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([staffId])
  @@index([templateId])
  @@map("hrm_staff_kpis")
}

/// Salary advance given to staff (recovered from payroll, not petty cash).
model HrmSalaryAdvance {
  id               String    @id @default(cuid())
  staffId          String    @map("staff_id")
  staff            ErpStaff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  amount           Float
  currency         String    @default("PKR")
  reason           String    @default("")
  notes            String    @default("")
  status           String    @default("outstanding") // outstanding | recovered | cancelled
  givenBy          String    @map("given_by")
  givenAt          DateTime  @default(now()) @map("given_at")
  recoveredAt      DateTime? @map("recovered_at")
  recoveredInMonth String?   @map("recovered_in_month")
  proofUrl         String?   @map("proof_url")
  proofName        String?   @map("proof_name")

  @@index([staffId, status])
  @@map("hrm_salary_advances")
}

/// Employee weekly/monthly KPI settlement (actuals + submit).
model HrmKpiSettlement {
  id           String    @id @default(cuid())
  staffId      String    @map("staff_id")
  staff        ErpStaff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  periodType   String    @default("weekly") @map("period_type")
  periodStart  String    @map("period_start") // YYYY-MM-DD
  periodEnd    String    @map("period_end")
  status       String    @default("draft") // draft | submitted | approved | rejected
  entries      Json      @default("[]") // [{ staffKpiId, name, target, actual, weight, unit }]
  weightedScore Float?   @map("weighted_score")
  employeeNotes String   @default("") @map("employee_notes")
  adminNotes   String    @default("") @map("admin_notes")
  submittedAt  DateTime? @map("submitted_at")
  submittedBy  String    @default("") @map("submitted_by")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewedBy   String    @default("") @map("reviewed_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([staffId, periodStart, periodEnd])
  @@index([staffId, status])
  @@map("hrm_kpi_settlements")
}

/// Employee daily activity report (self-created, submitted to admin).
model HrmDailyReport {
  id            String    @id @default(cuid())
  staffId       String    @map("staff_id")
  staff         ErpStaff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  reportDate    String    @map("report_date") // YYYY-MM-DD
  status        String    @default("draft") // draft | submitted | approved | rejected
  logs          Json      @default("[]") // [{ id, timeFrom, timeTo, details, imageUrls }]
  employeeNotes String    @default("") @map("employee_notes")
  adminNotes    String    @default("") @map("admin_notes")
  submittedAt   DateTime? @map("submitted_at")
  submittedBy   String    @default("") @map("submitted_by")
  reviewedAt    DateTime? @map("reviewed_at")
  reviewedBy    String    @default("") @map("reviewed_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([staffId, reportDate])
  @@index([reportDate, status])
  @@index([staffId])
  @@map("hrm_daily_reports")
}

model ErpFinanceRecord {
  id                  String   @id @default(cuid())
  title               String
  amount              Float
  currency            String
  purpose             String
  category            String
  tag                 String
  supplier_name              String   @default("") @map("supplier_name")
  receipt_person_name        String   @default("") @map("receipt_person_name")
  petty_cash_allocation_id   String   @default("") @map("petty_cash_allocation_id")
  petty_cash_receipt_id      String   @default("") @map("petty_cash_receipt_id")
  petty_cash_label           String   @default("") @map("petty_cash_label")
  proof_url           String   @map("proof_url")
  proof_name          String   @map("proof_name")
  notes               String
  created_by          String   @map("created_by")
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("erp_finance_records")
}

model ErpBranch {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  type        String   @default("outlet")
  address     String   @default("")
  city        String   @default("")
  country     String   @default("")
  phone       String   @default("")
  email       String   @default("")
  manager     String   @default("")
  status      String   @default("active")
  notes       String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by")

  @@map("erp_branches")
}

model ErpBranchInventory {
  id                String   @id @default(cuid())
  branchId          String   @map("branch_id")
  inventoryId       String   @map("inventory_id")
  productDescription String   @default("") @map("product_description")
  quantity          Float    @default(0)
  unit              String   @default("")
  assignedAt        DateTime @default(now()) @map("assigned_at")
  assignedBy        String   @map("assigned_by")
  notes             String   @default("")

  @@map("erp_branch_inventory")
}

model ErpBranchInventoryTransfer {
  id                 String   @id @default(cuid())
  fromBranchId       String?  @map("from_branch_id")
  fromBranchName     String   @map("from_branch_name")
  fromBranchCode     String   @default("") @map("from_branch_code")
