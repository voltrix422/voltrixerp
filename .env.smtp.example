# ─────────────────────────────────────────────────────────────────────────────
# Voltrix ERP — Email / SMTP setup
# Copy the block you need into .env.local (dev) or .env (production VPS)
# ─────────────────────────────────────────────────────────────────────────────
#
# HOW IT WORKS
# - SMTP_* = the ONE mailbox the ERP sends FROM (Hostinger OR Gmail)
# - Custom notification emails in Settings = where alerts are sent TO
# - Recipients can be ANY address: Gmail, Hostinger, Outlook, etc.
#
# Pick ONE sender below (Hostinger recommended for @voltrix.com)
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_BASE_URL=https://voltrixpv.com

# ── Option A: Hostinger (recommended for erp@yourdomain.com) ──
SMTP_PROVIDER=hostinger
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=erp@voltrix.com
SMTP_PASS=your-hostinger-mailbox-password
SMTP_FROM=erp@voltrix.com

# ── Option B: Gmail (use App Password, not normal Gmail password) ──
# 1. Enable 2-Step Verification on Google account
# 2. Create App Password: https://myaccount.google.com/apppasswords
# SMTP_PROVIDER=gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=yourname@gmail.com
